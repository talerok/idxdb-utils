{
  "name": "idxdb-utils",
  "version": "0.1.1",
  "description": "Utilities for working with IndexedDB",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "indexeddb",
    "idb",
    "browser",
    "storage",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/talerok/idxdb-utils.git"
  },
  "homepage": "https://github.com/talerok/idxdb-utils#readme",
  "bugs": {
    "url": "https://github.com/talerok/idxdb-utils/issues"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "fake-indexeddb": "^6.0.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
